# Example only. Replace address, hostname, paths, and subnet with your actual lab configuration.
# Bind only the approved interface. Firewall the interface independently.
server {
    listen 192.168.50.10:443 ssl;
    server_name exam.school.test;
    ssl_certificate C:/exam-certs/exam.school.test.pem;
    ssl_certificate_key C:/exam-certs/exam.school.test-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 1m;
    allow 192.168.50.0/24;
    deny all;
    # No access log: activation URLs are bearer secrets; do not log query strings.
    access_log off;
    location /static/ { alias C:/Secure_Exam_System/staticfiles/; }
    location / {
        proxy_set_header Host exam.school.test;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_pass http://127.0.0.1:8001;
        proxy_read_timeout 30s;
    }
}

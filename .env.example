# Run configure.py for a local-only prototype with generated keys.
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
EXAM_ENCRYPTION_KEY=
BASE_URL=https://exam.school.test
EXAM_PUBLIC_ORIGIN=https://exam.school.test
EXAM_SERVER_IP=
DJANGO_ALLOWED_HOSTS=exam.school.test
DB_ENGINE=mysql
DB_NAME=secure_exam
DB_USER=exam_app
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
# Only enable behind a firewalled reverse proxy which overwrites headers.
TRUST_PROXY_HTTPS=1
EXAM_TRUSTED_PROXY_CIDRS=127.0.0.1/32
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=exams@example.edu
# Independent backup key; preferably inject this only when backing up/restoring.
BACKUP_ENCRYPTION_KEY=

# Set automatically by Start-Hotspot.cmd; leave blank for normal local development.
EXAM_HOTSPOT_CIDR=
EXAM_HOTSPOT_IP=
